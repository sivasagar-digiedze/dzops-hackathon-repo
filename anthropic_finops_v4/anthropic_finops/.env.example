# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is already excluded via .gitignore — never commit the real file.

# Create an Admin API key at: https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_API_KEY=sk-ant-admin01-your-real-key-here

# Your MongoDB server connection string (username/password go in the URI).
MONGODB_URI=mongodb://<username>:<password>@<host>:<port>/?authSource=admin
MONGODB_DATABASE=dzops_core

# RabbitMQ durable collection-job queue
RABBITMQ_URL=amqp://username:password@rabbitmq-host:5672/vhost
RABBITMQ_QUEUE=anthropic_finops_collection

# Scheduler and MongoDB retry behavior
COLLECTION_INTERVAL_SECONDS=3600
SCHEDULER_STATE_FILE=.scheduler_state.json
# Optional inclusive start / exclusive end for hourly backfill
BACKFILL_START=
BACKFILL_END=
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_BASE_SECONDS=2
MONGODB_RETRY_MAX_SECONDS=60

# Optional collection name overrides (defaults shown — usually leave as-is)
# MONGODB_ORGANIZATIONS_COLLECTION=anthropic_organizations
# MONGODB_WORKSPACES_COLLECTION=anthropic_workspaces
# MONGODB_WORKSPACE_MEMBERS_COLLECTION=anthropic_workspace_members
# MONGODB_USERS_COLLECTION=anthropic_users
# MONGODB_API_KEYS_COLLECTION=anthropic_api_keys
# MONGODB_MODELS_COLLECTION=anthropic_models
# MONGODB_USAGE_COLLECTION=anthropic_usage
# MONGODB_COSTS_COLLECTION=anthropic_costs
# MONGODB_RATE_LIMITS_COLLECTION=anthropic_rate_limits
# MONGODB_SPEND_LIMITS_COLLECTION=anthropic_spend_limits
